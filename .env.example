DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=taskmanager
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_NAME=Initial Administrator
ADMIN_TEMP_PASSWORD=replace-with-an-8-character-minimum-temporary-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-gmail-address@gmail.com
# Recommended for Railway Trial/Free/Hobby: HTTPS email delivery via Resend.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Team Task Manager <onboarding@your-verified-domain.com>
NODE_ENV=development
PORT=3000
